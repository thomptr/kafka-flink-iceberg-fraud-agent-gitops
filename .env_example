# fraud-alert-agent — Minikube in-cluster service DNS names
# These values are correct for the pod running inside the fraud-agent namespace.
# For local dev outside the cluster, replace each FQDN with localhost and
# port-forward the relevant service first (e.g. kubectl port-forward -n ollama svc/ollama 11434:11434).

DATABASE_URL="postgresql+asyncpg://{user}:{password}@postgres.fraud-agent.svc.cluster.local:5432/fraud_agent"
OLLAMA_BASE_URL="http://ollama.ollama.svc.cluster.local:11434"
OLLAMA_MODEL="llama3.1:8b"
FRAUD_API_KEY=
SLACK_WEBHOOK_URL=
ICEBERG_CATALOG_URI="http://polaris.polaris.svc.cluster.local:8181/api/catalog"
MINIO_ENDPOINT="http://minio.minio.svc.cluster.local:9000"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KAFKA_BOOTSTRAP_SERVERS="platform-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092"
MLFLOW_TRACKING_URI="http://mlflow.mlflow.svc.cluster.local:5000"

POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=
POLARIS_CREDENTIAL=
POLARIS_S3_ACCESS_KEY_ID=
POLARIS_S3_SECRET_ACCESS_KEY=
